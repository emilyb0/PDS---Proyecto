# Configuración de ejemplo. Cópiela a .env (PowerShell: Copy-Item .env.example .env); no hace falta cambiar nada
# para desarrollar. El archivo .env NUNCA se sube al repositorio.
#
# IMPORTANTE: los comentarios van siempre en su propia línea. Docker Compose toma "VAR=   # texto" como si el
# valor fuera "# texto" cuando el valor está vacío.

# ---------------------------------------------------------------- Proyecto Docker
# Nombre del proyecto Compose: prefijo de los contenedores, los volúmenes y la red. Sin definir, es "robots-drones"
# (docker-compose.yml). Defínalo si en la misma máquina corre otra copia del sistema (por ejemplo, el proyecto
# completo) y cambie también los puertos de abajo, para que no compartan contenedores, datos ni puertos.
# COMPOSE_PROJECT_NAME=robots-drones-entrega1

# ---------------------------------------------------------------- Puertos de la máquina
# Elegidos para convivir con otros proyectos Docker (por ejemplo, uno que ya use 5432 u 8000).
# Dentro de Docker la API siempre usa db:5432; esto solo cambia lo que se publica en la máquina.
# PostgreSQL en 127.0.0.1:5433
PUERTO_BD=5433
# API en http://localhost:8010 (también lo usa `python -m app`)
PUERTO_API=8010
# 0.0.0.0 abre los puertos a la red local (no recomendado)
IP_PUBLICACION=127.0.0.1

# ---------------------------------------------------------------- Base de datos
POSTGRES_DB=robots
POSTGRES_USER=robots
# Cámbiela si la base queda expuesta.
POSTGRES_PASSWORD=robots_dev
# Lo que corre en la máquina (uvicorn, pytest, alembic) se conecta solo a 127.0.0.1:PUERTO_BD con los
# POSTGRES_* de arriba. Defina BD_URL solo para usar otra base; dentro de Compose se ignora.
BD_URL=
# Base de las pruebas; vacía = la misma base con el sufijo _test. Se borra y se recrea en cada corrida.
BD_URL_PRUEBAS=

# ---------------------------------------------------------------- Seguridad
# Secreto para firmar los JWT (y los enlaces de video de RF13, pendiente): mínimo 32 caracteres aleatorios.
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRETO=cambie-este-valor-por-uno-largo-y-aleatorio-0123456789
JWT_EXPIRA_HORAS=8
# Si se define, los correos de usuario deben ser de este dominio (RF18).
DOMINIO_CORREO_INSTITUCIONAL=campus.edu.co
# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGENES=http://localhost:5173

# ---------------------------------------------------------------- Entregas y funcionamiento
# Módulos de la entrega 2 (en esta entrega aún no hay ninguno): todos | ninguno | lista como rf02,rf03,rf15
MODULOS_ACTIVOS=todos
# Habilita /api/demo/... (solo administrador).
MODO_DEMO=true
# Inicio de reservas, monitoreo y reintento de subidas (y las tareas de los módulos, cuando existan).
TAREAS_ACTIVAS=true
NIVEL_LOG=INFO

# ---------------------------------------------------------------- Parámetros de negocio (especificación, sección 6)
# Los usa la entrega 1 (RF07, RF09–RF11 y el simulador).
BATERIA_MINIMA_ASIGNACION=30
BATERIA_ALERTA=20
# Para la demo puede bajarse a 1 (ver docs/demo.md).
RETRASO_ALERTA_MIN=10
INTERVALO_MONITOREO_SEG=5
FRACCION_RECORRIDO=0.8
# Para los RF pendientes: ya están en la configuración, los usarán sus módulos cuando existan.
# RF23 (clima)
VIENTO_MAX_KMH=30
LLUVIA_MAX_PCT=60
# RF16 (mantenimiento preventivo)
MANTENIMIENTO_DIAS=30
MANTENIMIENTO_HORAS=50
# RF26 (retención de videos)
RETENCION_VIDEO_MESES=3
# RF24 (entrega con código)
ESPERA_ENTREGA_MIN=5
MAX_INTENTOS_CODIGO=3
# RF13 (enlace firmado para reproducir videos)
VIDEO_URL_EXPIRA_MIN=10

# ---------------------------------------------------------------- Campus y simulador
BASE_UBICACION=Base de operaciones
# RF25 (pendiente): nombre de la zona de operación; vacío = la única zona registrada.
ZONA_OPERACION=
SEMILLA_SIMULADOR=42

# ---------------------------------------------------------------- Clima (RF23, pendiente)
# open-meteo | falso
CLIMA_PROVEEDOR=open-meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ---------------------------------------------------------------- Videos (RF12, RESTR04)
# local | s3
ALMACENAMIENTO=local
ALMACENAMIENTO_LOCAL_DIR=./datos/videos
PENDIENTES_DIR=./datos/pendientes
# Para AWS S3 (capa gratuita): bucket privado y credenciales de un usuario IAM con acceso solo a ese bucket.
S3_BUCKET=
S3_REGION=us-east-1
# Vacío = AWS; o la URL de un servicio compatible con S3.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
